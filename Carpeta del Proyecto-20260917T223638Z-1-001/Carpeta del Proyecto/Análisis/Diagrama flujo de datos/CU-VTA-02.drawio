  <diagram name="Página-1" id="ROrarVvwwB3PSKa9aYZz">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    actor V as Vendedor\n    actor A as Administrador\n    participant FE as Frontend\n    participant BE as Backend\n    participant DB as PostgreSQL\n\n    V-&gt;&gt;FE: Arma la venta y selecciona cliente con pago Cuenta Corriente\n    FE-&gt;&gt;BE: POST /ventas/validar con items e id_cliente\n\n    BE-&gt;&gt;DB: Consulta saldo_actual del cliente\n    BE-&gt;&gt;DB: Consulta limite_deuda del cliente\n    DB--&gt;&gt;BE: saldo_actual y limite_deuda\n\n    BE-&gt;&gt;BE: Suma saldo_actual + total de la venta\n    alt No supera el límite\n        BE--&gt;&gt;FE: 200 OK, venta permitida\n        FE-&gt;&gt;BE: POST /ventas confirma la venta\n        BE-&gt;&gt;DB: BEGIN transacción\n        BE-&gt;&gt;DB: INSERT en ventas y venta_items\n        BE-&gt;&gt;DB: UPDATE stock de productos\n        BE-&gt;&gt;DB: UPDATE saldo_actual del cliente\n        BE-&gt;&gt;DB: INSERT en auditoria\n        BE-&gt;&gt;DB: COMMIT\n        BE--&gt;&gt;FE: 201 Created con datos del comprobante\n        FE--&gt;&gt;V: Muestra comprobante de venta\n    else Supera el límite de deuda\n        BE--&gt;&gt;FE: 403 Forbidden con requiere_autorizacion true\n        FE--&gt;&gt;V: Muestra modal solicitando credenciales de Administrador\n        V-&gt;&gt;A: Solicita autorización\n        A-&gt;&gt;FE: Ingresa email y contraseña en el modal\n        FE-&gt;&gt;BE: POST /ventas/autorizar con payload de venta y credenciales del Admin\n\n        BE-&gt;&gt;DB: Busca Administrador por email\n        BE-&gt;&gt;BE: bcrypt.compare contraseña recibida vs hash\n        alt Credenciales incorrectas o sin permiso\n            BE--&gt;&gt;FE: 401 Unauthorized\n            FE--&gt;&gt;A: Error en el modal, puede reintentar\n        else Credenciales válidas y con permiso\n            BE-&gt;&gt;DB: BEGIN transacción\n            BE-&gt;&gt;DB: INSERT en ventas y venta_items\n            BE-&gt;&gt;DB: UPDATE stock de productos\n            BE-&gt;&gt;DB: UPDATE saldo_actual del cliente\n            BE-&gt;&gt;DB: INSERT en auditoria con Admin que autorizó y monto excedido\n            BE-&gt;&gt;DB: COMMIT\n            DB--&gt;&gt;BE: OK\n            BE--&gt;&gt;FE: 201 Created con datos del comprobante\n            FE--&gt;&gt;V: Cierra modal y muestra comprobante\n        end\n    end&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="s6yafJ1m5D3mk5cYztj9-1">
