<mxfile host="app.diagrams.net">
  <diagram name="Página-1" id="LYMhT9RO4ZUcQgb6zjin">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    actor U as Dueño / Supervisor\n    participant FE as Frontend\n    participant BE as Backend\n    participant DB as PostgreSQL\n\n    U-&gt;&gt;FE: Navega a Reportes y selecciona tipo de reporte\n    FE--&gt;&gt;U: Muestra formulario de parámetros\n    U-&gt;&gt;FE: Configura rango de fechas, categoría u otros filtros y presiona Generar\n    FE-&gt;&gt;BE: GET /reportes/:tipo con parámetros de filtro\n\n    BE-&gt;&gt;BE: Middleware valida Access Token y permisos del usuario\n    alt Token inválido o sin permisos\n        BE--&gt;&gt;FE: 401 Unauthorized o 403 Forbidden\n        FE--&gt;&gt;U: Acceso denegado, redirige a pantalla anterior\n    else Token válido y con permisos\n        BE-&gt;&gt;DB: Ejecuta consultas según tipo de reporte y parámetros\n        alt Sin datos para el período seleccionado\n            DB--&gt;&gt;BE: Array vacío\n            BE--&gt;&gt;FE: 200 OK con datos vacíos\n            FE--&gt;&gt;U: No hay datos disponibles para el período seleccionado\n        else Con datos\n            DB--&gt;&gt;BE: Datos del reporte\n            BE-&gt;&gt;BE: Construye estructura del reporte en JSON\n            BE--&gt;&gt;FE: 200 OK con datos del reporte\n            FE--&gt;&gt;U: Renderiza reporte en pantalla con tablas y gráficos\n\n            alt Usuario solicita exportar\n                U-&gt;&gt;FE: Selecciona Descargar PDF o Descargar Excel\n                FE-&gt;&gt;BE: GET /reportes/:tipo/exportar con formato y parámetros\n                BE-&gt;&gt;BE: Genera archivo en el formato solicitado\n                BE--&gt;&gt;FE: 200 OK con archivo generado\n                FE--&gt;&gt;U: Descarga el archivo en el dispositivo\n            end\n        end\n    end&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="FVTWBPU-ME-v5ejn619t-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=20;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
