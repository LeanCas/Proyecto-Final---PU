  <diagram name="Página-1" id="fDfX5Kuc6tJezKjt-6B3">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    actor A as Administrador\n    participant FE as Frontend\n    participant BE as Backend\n    participant DB as PostgreSQL\n\n    A-&gt;&gt;FE: Navega a la ficha del cliente y selecciona Nueva Nota de Crédito\n    FE--&gt;&gt;A: Muestra formulario de nota de crédito\n    A-&gt;&gt;FE: Ingresa monto, concepto y referencia a factura original si corresponde\n    FE-&gt;&gt;FE: Valida que monto sea mayor a cero y concepto no esté vacío\n    FE-&gt;&gt;BE: POST /clientes/:id/notas-credito con id_cliente, monto, concepto y referencia\n\n    BE-&gt;&gt;BE: Middleware valida Access Token y permisos del usuario\n    alt Token inválido o sin permisos\n        BE--&gt;&gt;FE: 401 Unauthorized o 403 Forbidden\n        FE--&gt;&gt;A: Acceso denegado\n    else Token válido y con permisos\n        BE-&gt;&gt;DB: BEGIN transacción\n        BE-&gt;&gt;DB: INSERT en movimientos_cc tipo CREDITO con monto y concepto\n        BE-&gt;&gt;DB: UPDATE saldo_actual del cliente restando el monto\n        BE-&gt;&gt;DB: INSERT en auditoria con usuario y timestamp\n        BE-&gt;&gt;DB: COMMIT\n        DB--&gt;&gt;BE: OK\n        BE--&gt;&gt;FE: 201 Created con datos del comprobante\n\n        alt Monto superior al saldo deudor\n            note over BE,FE: El excedente queda como saldo a favor del cliente\n            BE--&gt;&gt;FE: Informa saldo a favor resultante\n        end\n\n        FE--&gt;&gt;A: Muestra nota de crédito generada con opción de imprimir o descargar PDF\n    end&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="zG-Xl9hxBEIj9sZJR_kI-35">
