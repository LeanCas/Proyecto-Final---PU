  <diagram name="Página-1" id="WSuwL_iDJ7gRkdSEFyLh">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    actor E as Encargado de Depósito\n    participant FE as Frontend\n    participant BE as Backend\n    participant DB as PostgreSQL\n\n    E-&gt;&gt;FE: Selecciona archivo CSV o Excel y presiona Importar\n    FE-&gt;&gt;BE: POST /productos/importar con archivo multipart/form-data\n\n    BE-&gt;&gt;BE: Middleware valida Access Token y permisos del usuario\n    alt Token inválido o sin permisos\n        BE--&gt;&gt;FE: 401 Unauthorized o 403 Forbidden\n        FE--&gt;&gt;E: Acceso denegado\n    else Token válido y con permisos\n        BE-&gt;&gt;BE: Recibe archivo en memoria y valida formato\n\n        alt Archivo vacío o formato no reconocido\n            BE--&gt;&gt;FE: 400 Bad Request\n            FE--&gt;&gt;E: El archivo no es válido o está vacío\n        else Archivo válido\n            BE-&gt;&gt;DB: BEGIN transacción\n            loop Por cada fila del archivo\n                alt Fila con formato inválido\n                    note over BE: Fila omitida, se registra en reporte de errores\n                else Fila válida\n                    BE-&gt;&gt;DB: UPSERT en productos por codigo_barra\n                    note over DB: INSERT si no existe, UPDATE precio y stock si existe\n                    DB--&gt;&gt;BE: OK\n                end\n            end\n            BE-&gt;&gt;DB: INSERT en auditoria resumiendo la importación masiva\n            BE-&gt;&gt;DB: COMMIT\n            DB--&gt;&gt;BE: OK\n            BE--&gt;&gt;FE: 200 OK con filas procesadas y detalle de errores\n            FE--&gt;&gt;E: Muestra resumen de importación con productos actualizados y filas omitidas\n        end\n    end&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="Hg25sH3RiG7hPfb7BqZ8-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=20;" vertex="1">
