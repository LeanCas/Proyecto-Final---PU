    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    actor A as Administrador\n    participant FE as Frontend\n    participant BE as Backend\n    participant DB as PostgreSQL\n\n    A-&gt;&gt;FE: Navega a la sección Auditoría\n    FE-&gt;&gt;BE: GET /auditoria\n\n    BE-&gt;&gt;BE: Middleware valida Access Token y rol Administrador\n    alt Token inválido o rol insuficiente\n        BE--&gt;&gt;FE: 403 Forbidden\n        FE--&gt;&gt;A: Acceso denegado, redirige a pantalla principal\n    else Token válido y rol Administrador\n        BE-&gt;&gt;DB: SELECT en auditoria paginado ORDER BY timestamp DESC\n        DB--&gt;&gt;BE: Registros de auditoría\n        BE--&gt;&gt;FE: 200 OK con registros paginados\n        FE--&gt;&gt;A: Muestra listado con usuario, acción, entidad, fecha y hora\n\n        alt Usuario aplica filtros\n            A-&gt;&gt;FE: Filtra por usuario, tipo de acción o rango de fechas\n            FE-&gt;&gt;BE: GET /auditoria con parámetros de filtro\n            BE-&gt;&gt;DB: SELECT en auditoria con WHERE según filtros aplicados\n            DB--&gt;&gt;BE: Registros filtrados\n            BE--&gt;&gt;FE: 200 OK con registros filtrados\n            FE--&gt;&gt;A: Actualiza listado con resultados filtrados\n        end\n    end&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="_v_3MrVlVN6o6TaQ5Tqr-1">
