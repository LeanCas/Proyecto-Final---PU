<mxfile host="app.diagrams.net">
  <diagram name="Página-1" id="jnspf2QQAlwRxJ0PBnjQ">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    actor V as Vendedor\n    actor A as Administrador\n    participant FE as Frontend\n    participant BE as Backend\n    participant DB as PostgreSQL\n\n    V-&gt;&gt;FE: Escanea o busca producto y lo agrega a la venta\n    FE-&gt;&gt;BE: GET /productos/stock con id_producto\n    BE-&gt;&gt;DB: Consulta stock del producto\n    DB--&gt;&gt;BE: stock = 0\n    BE--&gt;&gt;FE: Stock en cero\n    FE--&gt;&gt;V: Advertencia visual — Producto sin stock disponible\n\n    V-&gt;&gt;FE: Confirma la venta de todas formas\n    FE-&gt;&gt;BE: POST /ventas con items e id_cliente\n\n    BE-&gt;&gt;DB: Verifica stock de los ítems\n    DB--&gt;&gt;BE: Stock en cero detectado\n    BE--&gt;&gt;FE: 403 Forbidden con requiere_autorizacion true e ítems sin stock\n\n    FE--&gt;&gt;V: Muestra modal con productos sin stock y solicita credenciales\n    V-&gt;&gt;A: Solicita autorización\n    A-&gt;&gt;FE: Ingresa email y contraseña en el modal\n\n    FE-&gt;&gt;BE: POST /ventas/autorizar-sin-stock con payload de venta y credenciales del Admin\n\n    BE-&gt;&gt;DB: Busca Administrador por email\n    BE-&gt;&gt;BE: bcrypt.compare contraseña recibida vs hash\n    BE-&gt;&gt;DB: Verifica permiso de venta sin stock\n\n    alt Credenciales incorrectas o sin permiso\n        BE--&gt;&gt;FE: 401 Unauthorized\n        FE--&gt;&gt;A: Error en el modal, puede reintentar\n    else Credenciales válidas y con permiso\n        BE-&gt;&gt;DB: BEGIN transacción\n        BE-&gt;&gt;DB: INSERT en ventas y venta_items\n        BE-&gt;&gt;DB: UPDATE stock del producto a valor negativo o cero según política\n        BE-&gt;&gt;DB: INSERT en auditoria con Admin que autorizó y productos sin stock\n        BE-&gt;&gt;DB: COMMIT\n        DB--&gt;&gt;BE: OK\n        BE--&gt;&gt;FE: 201 Created con datos del comprobante\n        FE--&gt;&gt;V: Cierra modal y muestra comprobante\n    end&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="WoKRRgj58at8Wxk0PiH3-1">
