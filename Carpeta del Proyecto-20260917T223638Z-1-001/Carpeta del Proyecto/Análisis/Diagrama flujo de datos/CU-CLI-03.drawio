  <diagram name="Página-1" id="ZdUp7NIoMNrvPTxtuhvE">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    actor A as Administrador\n    participant FE as Frontend\n    participant BE as Backend\n    participant DB as PostgreSQL\n\n    A-&gt;&gt;FE: Navega a la ficha del cliente y selecciona Nueva Nota de Débito\n    FE--&gt;&gt;A: Muestra formulario de nota de débito\n    A-&gt;&gt;FE: Selecciona facturas vencidas, ingresa monto y concepto\n    FE-&gt;&gt;FE: Valida que monto sea mayor a cero y concepto no esté vacío\n    FE-&gt;&gt;BE: POST /clientes/:id/notas-debito con id_cliente, monto, concepto y referencias\n\n    BE-&gt;&gt;BE: Middleware valida Access Token y permisos del usuario\n    alt Token inválido o sin permisos\n        BE--&gt;&gt;FE: 401 Unauthorized o 403 Forbidden\n        FE--&gt;&gt;A: Acceso denegado\n    else Token válido y con permisos\n        BE-&gt;&gt;DB: BEGIN transacción\n        BE-&gt;&gt;DB: INSERT en movimientos_cc tipo DEBITO con monto y concepto\n        BE-&gt;&gt;DB: UPDATE saldo_actual del cliente sumando el monto\n        BE-&gt;&gt;DB: INSERT en auditoria con usuario y timestamp\n        BE-&gt;&gt;DB: COMMIT\n        DB--&gt;&gt;BE: OK\n        BE--&gt;&gt;FE: 201 Created con datos del comprobante\n        FE--&gt;&gt;A: Muestra nota de débito generada con opción de imprimir o descargar PDF\n    end&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="ZScS6hyrvMH6FZJ5raLr-66">
